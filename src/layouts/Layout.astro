---
import { SEO } from "astro-seo";
import { ViewTransitions } from "astro:transitions";
import "../styles/global.scss";
import "@fontsource-variable/noto-serif-sc";

import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  moveDown: boolean;
}

const { title, description, moveDown } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image:
            "https://user-images.githubusercontent.com/5182256/131216951-8f74f425-f775-463d-a11b-0e01ad9fce8d.png",
        },
      }}
      twitter={{
        creator: "@sean_tha_swan",
      }}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="googlebot" content="index,follow" />

    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9FXFDTDRH4"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-9FXFDTDRH4");
    </script>
    <ViewTransitions />
    <style>
      .grain-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        background-image: url(/grain.png);
        background-repeat: repeat;
        background-size: 150px;
        opacity: 0.1;
        z-index: 999;
        animation: all ease 2s;
      }

      .grain-overlay.move-down {
        @apply sm:top-[50px] top-[200px];
      }

      .corner-frame {
        position: absolute;
        height: 10vh;
        width: 2vw;
      }

      .corner-frame--top {
        left: 1%;
        top: 1%;
        border-left: 0 solid black;
        border-top: 0 solid black;
      }
      .corner-frame--bottom {
        right: 1%;
        bottom: 1%;
        border-right: 0 solid black;
        border-bottom: 0 solid black;
      }
    </style>
  </head>
  <body class="flex flex-col justify-between">
    <div class=`${moveDown ? 'move-down' : '' } grain-overlay`></div>
    <div class="corner-frame corner-frame--top"></div>
    <div class="corner-frame corner-frame--bottom"></div>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
